🧠 OpenRouter = select,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
🖕 Adobe = select,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
📕 Xiaohongshu = select,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,🇨🇳 China,😓 Cheap,policy-regex-filter=.*
🍎 Apple = select,DIRECT,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
🖥 Microsoft = select,DIRECT,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
📝 Notion = select,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
💃 Scrape = select,DIRECT,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
🪙 Crypto = select,DIRECT,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap,policy-regex-filter=.*
🎯 Global Direct = select,DIRECT,🔰 Proxy,🔥 Auto
🐟 Final = select,🔰 Proxy,🤏 Manual,🤏 Manual A,🤏 Manual B,🔥 Auto,🇺🇲 United States,🇭🇰 Hong Kong,🇨🇳 Taiwan,🇸🇬 Singapore,🇯🇵 Japan,🇰🇷 Korea,🥬 Experimental,😓 Cheap
🥬 Experimental = select,policy-regex-filter=(实验)
😓 Cheap = select,policy-regex-filter=^((?!(台|日|韩|新|美|港|Expire|Traffic|流量|剩余)).)*$
🇭🇰 Hong Kong = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(香港|HK|Hong Kong|Hongkong)
🇯🇵 Japan = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|JP|Japan|Tokyo)
🇺🇲 United States = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|United States|America|California)
🇨🇳 Taiwan = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(台|新北|彰化|TW|Taiwan)
🇸🇬 Singapore = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(新加坡|坡|狮城|SG|Singapore)
🇰🇷 Korea = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(KP|韩国|韩)
🇨🇳 China = url-test,url=http://www.gstatic.com/generate_204,interval=300,tolerance=100,timeout=5,select=0,policy-regex-filter=(中国|CN|China)


